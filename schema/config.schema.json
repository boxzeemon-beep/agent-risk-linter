{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/boxzeemon-beep/agent-risk-linter/main/schema/config.schema.json",
  "title": "Agent Risk Linter configuration",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "failOn": {
      "enum": ["none", "low", "medium", "high", "critical"]
    },
    "ignore": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "disableRules": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Z]+[0-9]{3}$"
      },
      "uniqueItems": true
    },
    "overrides": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "files": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "disableRules": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Z]+[0-9]{3}$"
            },
            "minItems": 1
          }
        },
        "required": ["files", "disableRules"],
        "additionalProperties": false
      }
    },
    "maxFileBytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000000
    },
    "maxFiles": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100000
    },
    "semantic": {
      "type": "object",
      "properties": {
        "model": {
          "type": "string",
          "minLength": 1
        },
        "maxChars": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 200000
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
